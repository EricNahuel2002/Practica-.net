@model Entidades.Herramienta

@{
    ViewData["Title"] = "Editar Herramienta";
}

<div class="container mt-4">
    <h2 class="text-center mb-4">Editar Herramienta</h2>

    <form asp-controller="Herramienta" asp-action="Editar" method="post" class="shadow p-4 rounded bg-light">
        <!-- ID oculto -->
        <input type="hidden" asp-for="Id" />

        <div class="mb-3">
            <label class="form-label"></label>
            <input asp-for="Nombre" class="form-control" type="text" />
        </div>

        <div class="mb-3">
            <label class="form-label"></label>
            <input asp-for="Descripcion" class="form-control" type="text" />
        </div>

        <div class="mb-3">
            <label class="form-label"></label>
            <input asp-for="Stock" class="form-control" type="number" />
        </div>

        <div class="mb-3">
            <label class="form-label"></label>
            <input asp-for="Imagen" class="form-control" type="text" />
        </div>

        <button type="submit" class="btn btn-primary">
            <i class="bi bi-save"></i> Guardar Cambios
        </button>
        <a asp-controller="Herramienta" asp-action="Index" class="btn btn-secondary ms-2">
            Cancelar
        </a>
    </form>
</div>
