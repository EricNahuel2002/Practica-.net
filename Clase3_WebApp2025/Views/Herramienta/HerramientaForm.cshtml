@model Entidades.Herramienta

<div class="container mt-5">
    <h2 class="text-center mb-4">Agregar Herramienta</h2>

    <form asp-controller="Herramienta" asp-action="Agregar" method="post" class="shadow p-4 rounded bg-light">
        <div class="mb-3">
            <label asp-for="Nombre" class="form-label">Nombre</label>
            <input asp-for="Nombre" type="text" class="form-control" placeholder="Ingrese nombre" required />
        </div>

        <div class="mb-3">
            <label asp-for="Descripcion" class="form-label">Descripción</label>
            <input asp-for="Descripcion" type="text" class="form-control" placeholder="Ingrese descripción" required />
        </div>

        <div class="mb-3">
            <label asp-for="Stock" class="form-label">Stock</label>
            <input asp-for="Stock" type="text" class="form-control" placeholder="Ingrese stock" required />
        </div>

        <div class="mb-3">
            <label asp-for="Imagen" class="form-label">Imagen</label>
            <input asp-for="Imagen" type="text" class="form-control" placeholder="Ingrese ruta de imagen" />
        </div>

        <div class="text-center">
            <button type="submit" class="btn btn-success btn-lg">
                <i class="bi bi-plus-circle"></i> Guardar
            </button>
            <a asp-action="Index" class="btn btn-secondary btn-lg ms-2">Cancelar</a>
        </div>
    </form>
</div>
