@{
    var herramientas = ViewData["herramientasVD"] as List<Entidades.Herramienta>;
    @model Entidades.HerramientaView;
}

<div class="d-flex">
    <h6>De ViewData</h6>
    <ul>
        @foreach (var herramienta in herramientas)
        {
            <li>@herramienta.Id ==> @herramienta.Nombre</li>
        }
    </ul>
    <h6>De ViewBag</h6>
    <ul>
        @foreach (var herramienta in ViewBag.HerramientasVB)
        {
            <li>@herramienta.Id ==> @herramienta.Nombre</li>
        }
    </ul>
    <h6>De ViewModel</h6>
    <ul>
        <li>@Model.Nombre</li>
    </ul>
</div>

<form asp-controller="Sesion" asp-action="Mensaje" method="post">
    <button type="submit" class="btn btn-primary w-100">
        Click para que aparezca tempdata
    </button>
</form>
<p>@TempData["Mensaje"]</p>


