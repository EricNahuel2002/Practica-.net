# .gitignore para proyecto Razor Pages (.NET 8)

# Build / publish outputs
[Bb]in/
[Oo]bj/
out/
artifacts/
publish/

# Visual Studio y archivos de usuario
.vs/
*.suo
*.user
*.userosscache
*.sln.docstates

# Rider / JetBrains
.idea/

# VS Code
.vscode/

# Paquetes NuGet y artefactos
packages/
*.nupkg
.nuget/packages/
project.assets.json
project.lock.json

# Resultados de tests y cobertura
TestResults/
*.trx
coverage/
*.coverage
*.coveragexml

# Archivos de configuración local / secretos
secrets.json
local.settings.json
.env
.env.*
appsettings.*.Local.json

# Node / front-end
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log

# Bases de datos locales y archivos temporales
*.db
*.sqlite
*.mdf
*.ldf
*.db-shm
*.db-wal
*.bak

# Archivos generados por herramientas / IDEs
*.userprefs
*.cache
*.dbmdl
*.dotCover
*.ncrunch*
_ReSharper*/
_ReSharper.*
*.resharper

# Logs y archivos temporales del sistema
*.log
logs/
.DS_Store
Thumbs.db
desktop.ini

# Docker (archivos de override locales)
docker-compose.override.yml

# Otros
.vsconfig